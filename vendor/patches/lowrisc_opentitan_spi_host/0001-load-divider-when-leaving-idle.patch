diff --git a/rtl/spi_host_fsm.sv b/rtl/spi_host_fsm.sv
index 8b029cb..5cda95f 100644
--- a/rtl/spi_host_fsm.sv
+++ b/rtl/spi_host_fsm.sv
@@ -185,11 +185,16 @@ module spi_host_fsm
 
   assign active_o   = ~is_idle;
 
-  assign clk_cntr_d = sw_rst_i              ? 16'h0 :
-                      !clk_cntr_en          ? clk_cntr_q :
-                      is_idle               ? 16'h0 :
-                      new_command           ? clkdiv :
-                      (clk_cntr_q == 16'h0) ? clkdiv :
+  // The counter holds at zero only while the FSM stays in Idle or IdleCSBActive. A state changes
+  // only under fsm_en, with the counter at zero, so on a step out of them (an accepted command,
+  // or the step from IdleCSBActive to WaitTrail for another chip select) the counter loads the
+  // divider as on any other state change, and the first timeslice of the next state lasts
+  // CLKDIV+1 cycles.
+  assign clk_cntr_d = sw_rst_i                     ? 16'h0 :
+                      !clk_cntr_en                 ? clk_cntr_q :
+                      (is_idle && !state_changing) ? 16'h0 :
+                      new_command                  ? clkdiv :
+                      (clk_cntr_q == 16'h0)        ? clkdiv :
                       clk_cntr_q - 1;
 
   assign tx_stall_o = wr_en_internal & ~sr_wr_ready_i;
